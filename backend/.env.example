# --- Desarrollo local (Postgres local) ---
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=reciclamapa_db

# --- Producción (Supabase/Render): si se define DATABASE_URL, tiene
# prioridad sobre las variables DB_* de arriba y se conecta con SSL. ---
# DATABASE_URL=postgresql://usuario:password@host:5432/postgres

PORT=3000
JWT_SECRET=cambiar_por_un_secreto_largo_y_random

# --- CycloScan (detección de materiales con IA) ---
# API key de Anthropic (console.anthropic.com → API Keys). Sin esto, la
# página /escanear no funciona.
ANTHROPIC_API_KEY=
